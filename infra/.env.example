# Local development only. Set four different private passwords.
POSTGRES_BOOTSTRAP_PASSWORD=

# Compose uses the passwords for first-volume bootstrap. Export backend variables
# separately before starting the application; Compose does not export them.
DB_URL=jdbc:postgresql://127.0.0.1:5432/finance
DB_RUNTIME_USER=finance_runtime
DB_RUNTIME_PASSWORD=
DB_MIGRATOR_USER=finance_migrator
DB_MIGRATOR_PASSWORD=
DB_INVITE_PASSWORD=
# Admin command only. Do not pass INVITE_* credentials to the web process.
INVITE_DB_URL=jdbc:postgresql://127.0.0.1:5432/finance
INVITE_DB_USER=finance_invite_admin
INVITE_DB_PASSWORD=
# INVITE_DB_PASSWORD must match the role's DB_INVITE_PASSWORD above.
JWT_KEY_FILE=
JWT_CURRENT_KID=primary
SPRING_PROFILES_ACTIVE=local


# Local Mailpit only: docker compose --profile mail up -d
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@finance.local
MAIL_PUBLIC_URL=http://127.0.0.1:8080
# Production requires authenticated STARTTLS and a real HTTPS client URL.
SMTP_USERNAME=
SMTP_PASSWORD=
# Offline recovery CLI only; never add these to web process credentials.
RECOVERY_DB_URL=jdbc:postgresql://127.0.0.1:5432/finance
RECOVERY_DB_USER=finance_migrator
RECOVERY_DB_PASSWORD=
